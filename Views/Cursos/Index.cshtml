@model CursoCatalogoFiltroViewModel
@{
    ViewData["Title"] = "Catálogo de cursos";
}

<h2 class="mb-3">Catálogo de cursos</h2>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
    </div>
    <div class="col-md-2">
        <label asp-for="CreditosMin" class="form-label">Créditos mín.</label>
        <input asp-for="CreditosMin" class="form-control" />
        <span asp-validation-for="CreditosMin" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="CreditosMax" class="form-label">Créditos máx.</label>
        <input asp-for="CreditosMax" class="form-control" />
        <span asp-validation-for="CreditosMax" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="HorarioInicio" class="form-label">Desde</label>
        <input asp-for="HorarioInicio" type="time" class="form-control" />
    </div>
    <div class="col-md-2">
        <label asp-for="HorarioFin" class="form-label">Hasta</label>
        <input asp-for="HorarioFin" type="time" class="form-control" />
        <span asp-validation-for="HorarioFin" class="text-danger"></span>
    </div>
    <div class="col-12">
        <button class="btn btn-primary">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<div class="row g-3">
    @foreach (var curso in Model.Cursos)
    {
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="badge bg-dark">@curso.Codigo</span>
                            <h5 class="mt-2">@curso.Nombre</h5>
                        </div>
                        @if (curso.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                    </div>
                    <ul class="list-unstyled mt-3 mb-0">
                        <li><strong>Créditos:</strong> @curso.Creditos</li>
                        <li><strong>Cupo:</strong> @curso.CupoMaximo</li>
                        <li><strong>Horario:</strong> @curso.HorarioInicio.ToString(@"hh\:mm") - @curso.HorarioFin.ToString(@"hh\:mm")</li>
                    </ul>
                </div>
                <div class="card-footer bg-white border-0 pb-3">
                    <a asp-action="Details" asp-route-id="@curso.Id" class="btn btn-primary w-100">Ver detalle</a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
