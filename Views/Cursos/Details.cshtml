@model Curso
@{
    ViewData["Title"] = "Detalle del curso";
    var ocupadas = Model.Matriculas.Count(m => m.Estado != EstadoMatricula.Cancelada);
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-dark">@Model.Codigo</span>
                <h2 class="mt-2">@Model.Nombre</h2>
            </div>
            <span class="badge bg-success">Activo</span>
        </div>

        <div class="row mt-4">
            <div class="col-md-3"><strong>Créditos:</strong> @Model.Creditos</div>
            <div class="col-md-3"><strong>Cupo máximo:</strong> @Model.CupoMaximo</div>
            <div class="col-md-3"><strong>Ocupadas:</strong> @ocupadas</div>
            <div class="col-md-3"><strong>Disponibles:</strong> @(Model.CupoMaximo - ocupadas)</div>
        </div>

        <div class="mt-3">
            <strong>Horario:</strong> @Model.HorarioInicio.ToString(@"hh\:mm") - @Model.HorarioFin.ToString(@"hh\:mm")
        </div>

        <div class="mt-4 d-flex gap-2">
            <a asp-controller="Matriculas" asp-action="Crear" asp-route-cursoId="@Model.Id" class="btn btn-primary">Inscribirse</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Volver al catálogo</a>
            <a asp-controller="Matriculas"
                  asp-action="Create"
                   asp-route-cursoId="@Model.Id"
                class="btn btn-primary">
                Inscribirse</a>
        </div>
    </div>
</div>
