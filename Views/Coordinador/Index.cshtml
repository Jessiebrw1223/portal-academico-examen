@model CoordinadorDashboardViewModel
@{
    ViewData["Title"] = "Panel Coordinador";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Panel de Coordinador</h2>
    <a asp-action="CreateCourse" class="btn btn-primary">Nuevo curso</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Créditos</th>
            <th>Cupo</th>
            <th>Horario</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var curso in Model.Cursos)
    {
        <tr>
            <td>@curso.Codigo</td>
            <td>@curso.Nombre</td>
            <td>@curso.Creditos</td>
            <td>@curso.CupoMaximo</td>
            <td>@curso.HorarioInicio.ToString(@"hh\:mm") - @curso.HorarioFin.ToString(@"hh\:mm")</td>
            <td>
                @if (curso.Activo)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactivo</span>
                }
            </td>
            <td class="d-flex gap-2 flex-wrap">
                <a asp-action="EditCourse" asp-route-id="@curso.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                <a asp-action="MatriculasPorCurso" asp-route-id="@curso.Id" class="btn btn-sm btn-outline-dark">Matrículas</a>
                <form method="post" asp-action="ToggleActive" asp-route-id="@curso.Id">
                    <button type="submit" class="btn btn-sm btn-outline-warning">@(curso.Activo ? "Desactivar" : "Activar")</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
