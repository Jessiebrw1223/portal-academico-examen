@model MatricularViewModel
@{
    ViewData["Title"] = "Inscripción";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h4 mb-3">Inscribirse en @Model.CursoNombre</h2>
                <p class="text-muted">Código: @Model.CursoCodigo</p>
                <ul>
                    <li>Créditos: @Model.Creditos</li>
                    <li>Horario: @Model.HorarioInicio.ToString(@"hh\:mm") - @Model.HorarioFin.ToString(@"hh\:mm")</li>
                    <li>Cupos disponibles: @Model.CupoDisponible</li>
                </ul>

                @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
                {
                    <div class="alert @(Model.Exito ? "alert-success" : "alert-danger")">@Model.Mensaje</div>
                }

                <form method="post">
                    <input type="hidden" asp-for="CursoId" />
                    <button type="submit" class="btn btn-primary">Confirmar inscripción</button>
                    <a asp-controller="Cursos" asp-action="Details" asp-route-id="@Model.CursoId" class="btn btn-outline-secondary">Volver al curso</a>
                </form>
            </div>
        </div>
    </div>
</div>
